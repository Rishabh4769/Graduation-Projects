<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | Frolics</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles/admin/dashboard.css">
</head>
<body>
    <!-- Header (Stars + Background) -->
    <%- include('partials/header') %>

    <!-- Admin Navbar -->
    <%- include('partials/nav', { adminData: adminData, currentPage: 'dashboard' }) %>

    <!-- Main Content -->
    <main class="main">
        <div class="container pt-5">
            <!-- Welcome Section -->
            <div class="row mb-4">
                <div class="col">
                    <h1>Welcome, <%= adminData.name %></h1>
                    <p class="lead">Manage your events and participants</p>
                </div>
            </div>

            <!-- Stats Cards -->
            <div class="row mb-5">
                <div class="col-md-3 mb-4">
                    <div class="card text-center h-100">
                        <div class="card-body">
                            <h3><%= stats.totalEvents || 0 %></h3>
                            <p class="card-text">Total Events</p>
                        </div>
                    </div>
                </div>
                <!-- Add more stat cards -->
            </div>
        </div>
    </main>

    <!-- Footer -->
    <%- include('partials/footer') %>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/admin/adminDashboard.js"></script>
</body>
</html>
