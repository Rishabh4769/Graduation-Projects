<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Your Theme CSS -->
    <link rel="stylesheet" href="../../../public/styles/users/dashboard.css">
</head>
<body>
<header class="header">
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid">
            <!-- Logo -->
            <a class="navbar-brand fw-bold fs-3" href="/users/dashboard">
                <img src="/images/frolics_logo_main.png" alt="Frolics" width="40" height="40" class="me-2 rounded-3">
                FROLICS
            </a>

            <!-- Toggle button for mobile -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" 
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navbar Links -->
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    
                    <!-- Dashboard -->
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2" href="/users/dashboard">Dashboard</a>
                    </li>

                    <!-- Events Dropdown -->
                    <li class="nav-item dropdown">
                        <a class="nav-link px-3 py-2 dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" 
                           aria-expanded="false">
                            Events
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end bg-white/90 backdrop-blur-xl border-white shadow-lg border rounded-3 mt-1">
                            <li><a class="dropdown-item px-4 py-2 fw-medium" href="/users/events/list">📋 Event List</a></li>
                            <li><a class="dropdown-item px-4 py-2 fw-medium" href="/users/events/upcoming">🔥 Upcoming</a></li>
                            <li><hr class="dropdown-divider mx-3 my-1 opacity-50"></li>
                            <li><a class="dropdown-item px-4 py-2 fw-medium text-danger" href="/users/events/past">📊 Past Events</a></li>
                        </ul>
                    </li>

                    <!-- Groups Dropdown -->
                    <li class="nav-item dropdown">
                        <a class="nav-link px-3 py-2 dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" 
                           aria-expanded="false">
                            Groups
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end bg-white/90 backdrop-blur-xl border-white shadow-lg border rounded-3 mt-1">
                            <li><a class="dropdown-item px-4 py-2 fw-medium" href="/users/groups/mine">👥 My Groups</a></li>
                            <li><a class="dropdown-item px-4 py-2 fw-medium" href="/users/groups/create">➕ Create Group</a></li>
                            <li><a class="dropdown-item px-4 py-2 fw-medium" href="/users/groups/join">🔗 Join Group</a></li>
                        </ul>
                    </li>

                    <!-- Profile -->
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2" href="/users/profile">Profile</a>
                    </li>

                    <!-- User Profile Dropdown -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle px-3 py-2 d-flex align-items-center gap-2" href="#" 
                           role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="avatar bg-gradient rounded-circle d-flex align-items-center justify-content-center text-white fw-bold fs-6" 
                                 style="width: 32px; height: 32px;">
                                <%= userInitials || 'U' %>
                            </div>
                            <span class="d-none d-md-inline"><%= userName || 'User' %></span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end bg-white/95 backdrop-blur-xl shadow-2xl border-white border rounded-3 mt-1 w-auto min-w-0">
                            <li class="px-4 py-3 border-bottom">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar bg-gradient rounded-circle text-white fw-bold fs-6" 
                                         style="width: 40px; height: 40px;">
                                        <%= userInitials || 'U' %>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-semibold"><%= userName || 'User' %></h6>
                                        <small class="text-muted"><%= userEmail || 'user@example.com' %></small>
                                    </div>
                                </div>
                            </li>
                            <li><a class="dropdown-item px-4 py-3 fw-medium" href="/users/profile">View Profile</a></li>
                            <li><hr class="dropdown-divider mx-3 opacity-50"></li>
                            <li>
                                <form method="POST" action="/logout" class="px-2">
                                    <button type="submit" class="dropdown-item px-4 py-3 fw-medium">Logout</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
