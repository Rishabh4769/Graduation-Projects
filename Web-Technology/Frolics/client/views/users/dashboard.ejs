<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Dashboard - Frolics</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles/users/dashboard.css">
</head>
<body>
    <!-- Stars + Background (Your JS auto-generates) -->
    <div class="stars-container" id="starsContainer"></div>
    <div class="background-decoration">
        <div class="bg-shape-1"></div>
        <div class="bg-shape-2"></div>
    </div>

    <!-- Navbar -->
    <%- include('partials/nav') %>

    <!-- Main Content -->
    <main class="main">
        <div class="container">
            <!-- Page Header -->
            <%- include('partials/header', { 
                title: 'Welcome to Dashboard', 
                subtitle: 'Manage your events and activities' 
            }) %>

            <!-- Stats Grid (Empty - styled only) -->
            <section class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon">🎫</div>
                    <div class="stat-content">
                        <h3>0</h3>
                        <p>Total Events</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">👥</div>
                    <div class="stat-content">
                        <h3>0</h3>
                        <p>Group Members</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">⭐</div>
                    <div class="stat-content">
                        <h3>0</h3>
                        <p>Total Wins</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">📊</div>
                    <div class="stat-content">
                        <h3>0</h3>
                        <p>Attendance</p>
                    </div>
                </div>
            </section>

            <!-- Quick Actions -->
            <section class="actions-section">
                <h2>Quick Actions</h2>
                <div class="actions-grid">
                    <a href="/users/events" class="action-btn primary">📅 View Events</a>
                    <a href="/users/groups" class="action-btn secondary">👥 My Groups</a>
                    <a href="/users/profile" class="action-btn secondary">✏️ Edit Profile</a>
                </div>
            </section>
        </div>
    </main>

    <!-- Footer -->
    <%- include('partials/footer') %>

    <script src="/js/users/userDashboard.js"></script>
</body>
</html>
