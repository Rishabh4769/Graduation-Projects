<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Frolics | Dashboard</title>
    <link rel="stylesheet" href="/styles/users/userDashboard.css">
</head>
<body>
    <div class="stars-container" id="starsContainer"></div>

    <!-- Background Decorations -->
    <div class="background-decoration">
        <div class="bg-shape-1"></div>
        <div class="bg-shape-2"></div>
    </div>

    <!-- Header -->
    <header class="header">
        <div class="navbar">
            <div class="nav-container">
                <a href="#" class="logo">
                    <img src="/images/frolics_logo_main.png" alt="Frolics logo">
                    FROLICS
                </a>
                <ul class="nav-links">
                    <li class="nav-link"><a href="/user/<%= userdetails.id %>/<%= userdetails.username %>/dashboard">Dashboard</a></li>
                    <li class="nav-link"><a href="/user/<%= userdetails.id %>/<%= userdetails.username %>/events">Events</a></li>
                    <li class="nav-link"><a href="/user/<%= userdetails.id %>/<%= userdetails.username %>/profile">Profile</a></li>
                </ul>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="main">
        <div class="container">
            <!-- Welcome Section -->
            <div class="welcome-section">
                <h1 class="welcome-title">Welcome back, <span style="color: #3b82f6;"><%= userdetails.username %>!</span></h1>
                <p class="welcome-subtitle">Manage your events and activities with ease</p>
            </div>

            <!-- Stats Cards -->
            <section class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon">🎫</div>
                    <div class="stat-content">
                        <h3>Musicals</h3>
                        <p>Event 1</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">📅</div>
                    <div class="stat-content">
                        <h3>Movie Mania</h3>
                        <p>Event 2</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">⭐</div>
                    <div class="stat-content">
                        <h3>Codathon</h3>
                        <p>Event 3</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">💰</div>
                    <div class="stat-content">
                        <h3>Treasurea</h3>
                        <p>Event 4</p>
                    </div>
                </div>
            </section>

            <!-- Quick Actions -->
            <section class="actions-section">
                <h2>Quick Actions</h2>
                <div class="actions-grid">
                    <a href="/create-event" class="action-btn primary">
                        ➕ Participate
                    </a>
                    <a href="/my-tickets" class="action-btn secondary">
                        🎟️ View Tickets
                    </a>
                    <!-- <a href="/analytics" class="action-btn secondary">
                        📊 Check Analytics
                    </a> -->
                </div>
            </section>
        </div>
    </main>
    <script src="/js/users/userDashboard.js"></script>
</body>
</html>
