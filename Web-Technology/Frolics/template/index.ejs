<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FROLICS | College Event Management System</title>
    <link rel="stylesheet" href="/styles/index.css">
</head>
<body>
    <!-- Falling stars animation container -->
    <div class="stars-container"></div>

    <div class="background-decoration">
        <div class="bg-shape-1"></div>
        <div class="bg-shape-2"></div>
        <div class="diagonal-line"></div>
    </div>

    <!-- Navigation -->
    <nav>
        <a href="/" class="logo">
            <div class="logo-circle">F</div>
            FROLICS
        </a>
        <div class="nav-actions">
            <a href="/login" class="btn-login">Log In</a>
            <a href="/register" class="btn-signup">Sign Up</a>
        </div>
    </nav>

    <!-- Hero Section -->
    <main class="hero-section">
        <div class="hero-content">
            <div class="badge">
                Darshan University
            </div>
            <h1 class="hero-title">
                ✨ Welcome to FROLICS ✨
                <span class="gradient-text"></span>
            </h1>
            <p class="hero-description">
                The ultimate platform for organizing, managing, and participating in events of Darshan University. 
                Technical & Non-Technical events, Fun all in one place.
            </p>
            <div class="hero-buttons">
                <a href="/register" class="btn-primary">
                    Get Registered Now
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
                <a href="#features" class="btn-secondary">
                    Learn More
                </a>
            </div>
            <div class="stats">
                <div class="stat-item">
                    <div class="stat-number">500+</div>
                    <div class="stat-label">Events Hosted</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">10K+</div>
                    <div class="stat-label">Students Participated</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">50+</div>
                    <div class="stat-label">Colleges</div>
                </div>
            </div>
        </div>
    </main>

    <!-- Features Section -->
    <section class="features-section" id="features">
        <div class="features-container">
            <h2 class="section-title">Why Choose FROLICS?</h2>
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">🎯</div>
                    <h3>Easy Registration</h3>
                    <p>Quick and simple event registration process for students and organizers.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">📊</div>
                    <h3>Real-time Analytics</h3>
                    <p>Track event performance and participant engagement in real-time.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">💳</div>
                    <h3>Secure Payments</h3>
                    <p>Integrated UPI and payment gateway for hassle-free transactions.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">🏆</div>
                    <h3>Competitions</h3>
                    <p>Organize sports, cultural, and technical competitions effortlessly.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">📱</div>
                    <h3>Mobile Friendly</h3>
                    <p>Access events and manage registrations from any device.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">🔔</div>
                    <h3>Notifications</h3>
                    <p>Get instant updates about events, results, and announcements.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <p>&copy; 2026 FROLICS. Made with ❤️ by Darshan University Students</p>
    </footer>

    <script src="/js/index.js"></script>
</body>
</html>