<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | Frolics</title>
    <link rel="stylesheet" href="/styles/admin/adminDashboard.css">
</head>
<body>
    <!-- Stars Container -->
    <div class="stars-container" id="starsContainer"></div>

    <!-- Background Decorations -->
    <div class="background-decoration">
        <div class="bg-shape-1"></div>
        <div class="bg-shape-2"></div>
    </div>

    <!-- Header -->
    <header class="header">
        <div class="navbar">
            <div class="nav-container">
                <a href="/admin/dashboard" class="logo">
                    <img src="/images/frolics_logo_main.png" alt="Frolics Admin">
                    FROLICS Admin
                </a>
                <ul class="nav-links">
                    <li class="nav-link active"><a href="#dashboard">Dashboard</a></li>
                    <li class="nav-link"><a href="#institutes">Institutes</a></li>
                    <li class="nav-link"><a href="#events">Events</a></li>
                    <li class="nav-link"><a href="#users">Users</a></li>
                    <li class="nav-link"><a href="#departments">Departments</a></li>
                    <li class="nav-link"><a href="/admin/<%= admindetails.id %>/<%= admindetails.username %>/profile">Profile</a></li>
                </ul>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="main">
        <div class="container">
            <!-- Welcome Section -->
            <div class="welcome-section">
                <h1 class="welcome-title">Admin Dashboard</h1>
                <p class="welcome-subtitle">Manage Frolics events, users & departments</p>
            </div>

            <!-- Admin Stats Cards -->
            <section class="stats-grid">
                <div class="stat-card primary">
                    <div class="stat-icon">👥</div>
                    <div class="stat-content">
                        <h3>1,247</h3>
                        <p>Total Users</p>
                    </div>
                </div>
                <div class="stat-card success">
                    <div class="stat-icon">🎪</div>
                    <div class="stat-content">
                        <h3>456</h3>
                        <p>Total Events</p>
                    </div>
                </div>
                <div class="stat-card warning">
                    <div class="stat-icon">📊</div>
                    <div class="stat-content">
                        <h3>₹2.5M</h3>
                        <p>Total Revenue</p>
                    </div>
                </div>
                <div class="stat-card danger">
                    <div class="stat-icon">⚠️</div>
                    <div class="stat-content">
                        <h3>23</h3>
                        <p>Pending Reviews</p>
                    </div>
                </div>
            </section>

            <!-- Admin Overview Cards -->
            <section class="overview-grid">
                <div class="overview-card">
                    <h3>Recent Events</h3>
                    <div class="event-list">
                        <div class="event-item">
                            <div class="event-info">
                                <h4>Tech Fest 2026</h4>
                                <p>Technical Department • 150 attendees</p>
                            </div>
                            <span class="event-status active">Live</span>
                        </div>
                        <div class="event-item">
                            <div class="event-info">
                                <h4>Cultural Night</h4>
                                <p>Cultural Department • 320 attendees</p>
                            </div>
                            <span class="event-status upcoming">Upcoming</span>
                        </div>
                    </div>
                    <a href="/admin/events" class="view-all">View All Events →</a>
                </div>

                <div class="overview-card">
                    <h3>New Users (This Week)</h3>
                    <div class="user-list">
                        <div class="user-item">
                            <div class="user-avatar">RP</div>
                            <div class="user-info">
                                <h4>Rishabh Patel</h4>
                                <p>rishabh@darshan.ac.in</p>
                            </div>
                        </div>
                        <div class="user-item">
                            <div class="user-avatar">SP</div>
                            <div class="user-info">
                                <h4>Shivam Patel</h4>
                                <p>shivam@darshan.ac.in</p>
                            </div>
                        </div>
                    </div>
                    <a href="/admin/users" class="view-all">Manage Users →</a>
                </div>
            </section>

            <!-- Quick Admin Actions -->
            <section class="actions-section">
                <h2>Quick Actions</h2>
                <div class="actions-grid">
                    <a href="/admin/create-event" class="action-btn primary">
                        ➕ New Event
                    </a>
                    <a href="/admin/users" class="action-btn secondary">
                        👥 Manage Users
                    </a>
                    <a href="/admin/departments" class="action-btn secondary">
                        🏢 Departments
                    </a>
                    <a href="/admin/analytics" class="action-btn secondary">
                        📈 Analytics
                    </a>
                    <a href="/admin/pending-reviews" class="action-btn warning">
                        ⚠️ Pending Reviews
                    </a>
                </div>
            </section>
        </div>
    </main>

    <script src="/js/admin/adminDashboard.js"></script>
</body>
</html>
