<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Profile | Frolics</title>
    <link rel="stylesheet" href="/styles/profile.css">
</head>
<body>
    <!-- Stars + Background -->
    <div class="stars-container" id="starsContainer"></div>
    <div class="background-decoration">
        <div class="bg-shape-1"></div>
        <div class="bg-shape-2"></div>
    </div>

    <!-- Admin Header -->
    <header class="header">
        <div class="navbar">
            <div class="nav-container">
                <a href="/admin/dashboard" class="logo">
                    <img src="/images/frolics_logo_main.png" alt="Frolics Admin">
                    FROLICS Admin
                </a>
                <ul class="nav-links">
                    <li class="nav-link"><a href="/admin/<%= admindetails.id %>/<%= admindetails.username %>">Dashboard</a></li>
                    <li class="nav-link"><a href="#institutes">Institutes</a></li>
                    <li class="nav-link"><a href="#events">Events</a></li>
                    <li class="nav-link"><a href="#users">Users</a></li>
                    <li class="nav-link"><a href="#report">Report</a></li>
                    <li class="nav-link"><a href="/admin/<%= admindetails.id %>/<%= admindetails.username %>/profile">Profile</a></li>
                </ul>
            </div>
        </div>
    </header>

    <!-- Admin Content -->
    <main class="main">
        <div class="container">
            <div class="profile-header">
                <h1 class="profile-title">Admin Profile</h1>
                <p class="profile-subtitle">Administrator Information</p>
            </div>

            <div class="profile-details-grid">
                <!-- Admin Personal Info -->
                <div class="detail-card">
                    <h3>Administrator Details</h3>
                    <div class="detail-row">
                        <span class="detail-label">Full Name:</span>
                        <span class="detail-value"><%= admindetails.firstName %> <%= admindetails.lastName %></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Email:</span>
                        <span class="detail-value"><%= admindetails.email %></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Phone:</span>
                        <span class="detail-value"><%= admindetails.phone || 'Not provided' %></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Admin Since:</span>
                        <span class="detail-value"><%= new Date(admindetails.createdAt).toLocaleDateString() %></span>
                    </div>
                </div>

                <!-- Admin Stats -->
                <div class="detail-card">
                    <h3>Admin Statistics</h3>
                    <div class="detail-row">
                        <span class="detail-label">Total Users:</span>
                        <span class="detail-value">1,247</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Total Events:</span>
                        <span class="detail-value">456</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Pending Reviews:</span>
                        <span class="detail-value">23</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Role:</span>
                        <span class="detail-value status-admin">Administrator</span>
                    </div>
                </div>
            </div>

            <div class="profile-actions">
                <a href="/admin/change-password" class="action-btn secondary">
                    🔐 Change Password
                </a>
            </div>
        </div>
    </main>

    <script src="/js/profile.js"></script>
</body>
</html>
